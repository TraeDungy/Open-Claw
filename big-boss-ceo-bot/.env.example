# BIG BOSS CEO bot — copy to .env next to bot.mjs and fill in real values.
# Loaded by env.mjs at startup. NEVER commit the real .env.

# Telegram
BOT_TOKEN=123456789:your-telegram-bot-token
CHAT_ID=your-telegram-chat-id

# Paperclip
COMPANY_ID=your-paperclip-company-uuid
CEO_AGENT_ID=your-ceo-agent-uuid
PAPERCLIP_CLI=/path/to/node_modules/.bin/paperclipai
PAPERCLIP_URL=http://localhost:3100
PAPERCLIP_TOKEN=local-board

# LiteLLM
LITELLM_BASE_URL=http://127.0.0.1:9000/v1
LITELLM_API_KEY=sk-your-litellm-key
LITELLM_MODEL=llm-kimi
LITELLM_TIMEOUT_MS=120000

# Loop timing (optional — these are the defaults)
POLL_INTERVAL_MS=120000
CEO_LOOP_INTERVAL_MS=900000
DIGEST_CRON=0 9 * * *
